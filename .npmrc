# .npmrc — supply-chain hardening

# Explicit registry — prevents dependency confusion attacks.
# Without this, npm may resolve from unexpected sources.
registry=https://registry.npmjs.org/

# Block lifecycle scripts (preinstall/postinstall) by default.
# Many supply-chain attacks execute via postinstall in a transitive dep.
# Packages that need scripts must be run explicitly after install.
ignore-scripts=true

# Block git dependencies. Git deps can include .npmrc that overrides
# the git executable path, enabling arbitrary code execution during install
# EVEN WITH ignore-scripts=true.
# npm 11.10+; older npm silently ignores (safe to include unconditionally).
allow-git=none

# Don't install packages published less than 7 days ago.
# Most malicious packages are detected and yanked within hours to days.
# npm 11.10+; older npm silently ignores (safe to include unconditionally).
min-release-age=7

# Pin exact versions. No ^1.13.6 resolving to 1.14.1 on next install.
# Every version bump becomes a deliberate, reviewable decision.
save-exact=true
